<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FB"
    android:id="@+id/create_quiz_2">

    <!-- TOP BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/closeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/close"
                android:contentDescription="Close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Quizzo"
                android:textColor="#2C2151"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/closeIcon"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/listIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_list"
                android:contentDescription="Menu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- COVER IMAGE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/coverImageCard"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="#EEE"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@+id/topBarCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/addCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/add_photo"
                android:contentDescription="Add Cover Image"/>
            ...
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- QUIZ SETTINGS -->
    <LinearLayout
        android:id="@+id/quizSettingsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@+id/coverImageCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_time_limit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#7D49FA"
            android:text="20 sec"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="24dp" />

        <Button
            android:id="@+id/pointsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="#FFD668"
            android:text="100 pt"
            android:textColor="#60451F"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="24dp" />

        <Spinner
            android:id="@+id/quizTypeSpinner"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_outline_purple"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <!-- ADD QUESTION CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/addQuestionCard"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#E3E3E3"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@+id/quizSettingsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/questionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tap to add question"
            android:textColor="#7D49FA"
            android:textSize="18sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <!-- ANSWER BUTTONS GRID (MaterialButton) -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/addQuestionCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:id="@+id/answerButtonsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="12dp"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:text="Add answer"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp"
                app:backgroundTint="#EA4335"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:text="Add answer"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp"
                app:backgroundTint="#34A853"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:text="Add answer"
                android:textColor="#B68D00"
                app:cornerRadius="14dp"
                app:backgroundTint="#FBBC05"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="6dp"
                android:layout_columnWeight="1"
                android:text="Add answer"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp"
                app:backgroundTint="#4285F4"
                style="@style/Widget.MaterialComponents.Button" />
        </GridLayout>

    </androidx.cardview.widget.CardView>

    <!-- BOTTOM BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomBarCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="7dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/numberedInput"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:hint="1"
                android:background="@drawable/purple_border_background"
                android:textColorHint="#999"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:gravity="center"
                android:inputType="number" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/addButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/add"
                android:background="@color/black"
                android:backgroundTint="#7D49FA"
                app:tint="@android:color/white"
                android:elevation="4dp"
                android:contentDescription="Add" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
