<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/invite_and_scan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/arrowback"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Invite Friends to play"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:textColor="#242424"/>
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search friends name or email"
            android:padding="12dp"
            android:background="#ECEAFF"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

        <!-- Friends Selected Header -->
        <TextView
            android:id="@+id/friendsSelectedHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Friends Selected (16)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="8dp"/>

        <!-- Row of Friend Avatars -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/avatarRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author1"
                    android:contentDescription="Friend Avatar"
                    android:layout_marginEnd="10dp"
                    android:background="#EEEEEE"
                    android:padding="2dp"/>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author2"
                    android:contentDescription="Friend Avatar"
                    android:layout_marginEnd="10dp"
                    android:background="#EEEEEE"
                    android:padding="2dp"/>
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author4"
                    android:contentDescription="Friend Avatar"
                    android:layout_marginEnd="10dp"
                    android:background="#EEEEEE"
                    android:padding="2dp"/>
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author5"
                    android:contentDescription="Friend Avatar"
                    android:layout_marginEnd="10dp"
                    android:background="#EEEEEE"
                    android:padding="2dp"/>
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author3"
                    android:contentDescription="Friend Avatar"
                    android:background="#EEEEEE"
                    android:padding="2dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- List of Friends -->
        <LinearLayout
            android:id="@+id/friendsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Friend 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:elevation="2dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author1"
                    android:contentDescription="Friend Avatar"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedro Dorrance"
                    android:textSize="16sp"
                    android:textColor="#232323"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Friend 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:elevation="2dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author2"
                    android:contentDescription="Friend Avatar"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tyra Shelburne"
                    android:textSize="16sp"
                    android:textColor="#232323"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Friend 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:elevation="2dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/author3"
                    android:contentDescription="Friend Avatar"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dary Kulikowski"
                    android:textSize="16sp"
                    android:textColor="#232323"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnInvitePlayNow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Invite and Play Now"
                android:textColor="#FFFFFF"
                android:background="#9C27B0"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnQRCode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="QR Code"
                android:textColor="#FFFFFF"
                android:background="#3F51B5"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
