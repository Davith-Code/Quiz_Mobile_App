<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:id="@+id/quiz10"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/10"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drop Pin"
                android:fontFamily="@font/poppinssemibold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/menu"
                android:contentDescription="Menu Icon" />
        </LinearLayout>

        <!-- Progress Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginBottom="16dp">

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="100"
                android:max="100"
                android:progressTint="#4CAF50"
                android:backgroundTint="#E0E0E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textSize="10sp"
                android:textColor="#000000"
                android:layout_gravity="center" />
        </FrameLayout>


        <!-- Result Banner (hidden by default) -->
        <TextView
            android:id="@+id/result_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correct!"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="#4CAF50"
            android:padding="12dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"/>

        <!-- Question -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Base of the objects in the picture below what picture have pin ?"
            android:textSize="18sp"
            android:fontFamily="@font/poppinssemibold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <!-- Image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/object"
            android:scaleType="centerCrop"
            android:contentDescription="Objects to choose from"
            android:layout_marginBottom="12dp" />


        <!-- Multiple Choice Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_glasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glasses"
            android:backgroundTint="#2196F3"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera"
            android:backgroundTint="#F44336"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_coffee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coffee"
            android:backgroundTint="#FF9800"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notebook"
            android:backgroundTint="#4CAF50"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pencil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pencil"
            android:backgroundTint="#795548"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_eraser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eraser"
            android:backgroundTint="#607D8B"
            android:fontFamily="@font/poppinssemibold"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Finish Button -->
        <Button
            android:id="@+id/btn_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finish"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#7B61FF"
            android:textSize="17sp"
            android:padding="14dp"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</ScrollView>
